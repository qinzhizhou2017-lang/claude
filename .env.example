# Feishu App Credentials (from https://open.feishu.cn/app)
FEISHU_APP_ID=your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here

# Optional: event subscription tokens (can be empty for long-connection mode)
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# Drive folder tokens to scan (comma-separated)
# Get from folder URL: https://xxx.feishu.cn/drive/folder/XXXfolderTokenXXX
FEISHU_FOLDER_TOKENS=

# Document sync interval in seconds (default: 1 hour)
DOC_SYNC_INTERVAL=3600

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
