# ============================================================
#  Hermes Agent Environment Variables
#  Copy to ~/.hermes/.env and fill in your values
# ============================================================

# --- LLM Provider API Keys ---
# Set the key for your chosen provider (only one needed)
# OPENROUTER_API_KEY=sk-or-xxx
# OPENAI_API_KEY=sk-xxx
# NOUS_API_KEY=nous-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx

# --- Messaging Gateway Tokens ---
# TELEGRAM_BOT_TOKEN=123456:ABCdef
# DISCORD_BOT_TOKEN=xxx
# SLACK_APP_TOKEN=xapp-xxx
# SLACK_BOT_TOKEN=xoxb-xxx

# --- Voice & TTS ---
# ELEVENLABS_API_KEY=xxx

# --- MCP Server Tokens ---
# GITHUB_TOKEN=ghp_xxx

# --- Advanced ---
# HERMES_HOME=~/.hermes
# HERMES_LOG_LEVEL=INFO
# HERMES_TERMINAL_BACKEND=local
